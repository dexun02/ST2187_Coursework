            <column caption='New Percentage of orders delayed' datatype='real' name='[Calculation_511440083560243206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4153163330236829697]-7.55' />
            </column>
            <column caption='Original Discount (%)' datatype='real' name='[Calculation_511440083563483144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Discount] *100' />
            </column>
            <column caption='New Discount (%)' datatype='integer' name='[Calculation_511440083563802633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='20' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Myanmar (Burma)&quot;' value='Myanmar' />
