            <column caption='total cost ' datatype='real' name='[Calculation_1784269903451029505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sales] - [Profit]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Myanmar (Burma)&quot;' value='Myanmar' />
              </aliases>
            </column>
