          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>Combined effect for Philippines</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11' italic='true'>- 20% reduction in total cost, 10% more efficient use of discounts, 10%  from lower delivery delay, estimated 30% increase in profits</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
