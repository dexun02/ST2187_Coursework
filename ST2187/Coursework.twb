    <worksheet name='P Amount of shipping delays increasing'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>Shipping delays over time</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11' italic='true'>- delays for office supplies are increasing</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ST2187_coursework_dataset_2024-25)' name='federated.17goc4d1r1r4v21gkp8000wxland' />
          </datasources>
          <datasource-dependencies datasource='federated.17goc4d1r1r4v21gkp8000wxland'>
            <column caption='Shipping Days' datatype='integer' name='[Calculation_1784269903117389824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date],[Ship Date])' />
            </column>
            <column caption='Delayed or not' datatype='integer' name='[Calculation_3981463594611957760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4153163330238590978] = &apos;Delayed&apos; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Shipping delay status (simplified)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_4153163330238590978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Ship Mode] = &apos;Same Day&apos; AND [Calculation_1784269903117389824] &gt; 0 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;First Class&apos; AND [Calculation_1784269903117389824] &gt; 2 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Second Class&apos; AND [Calculation_1784269903117389824] &gt; 3 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Standard Class&apos; AND [Calculation_1784269903117389824] &gt; 5 THEN &apos;Delayed&apos;&#13;&#10;ELSE &apos;On Time&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Myanmar (Burma)&quot;' value='Myanmar' />
              </aliases>
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Ship Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3981463594611957760]' derivation='Sum' name='[sum:Calculation_3981463594611957760:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Month-Trunc' name='[tmn:Order Date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17goc4d1r1r4v21gkp8000wxland].[none:Country:nk]'>
            <groupfilter function='member' level='[none:Country:nk]' member='&quot;Philippines&quot;' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
