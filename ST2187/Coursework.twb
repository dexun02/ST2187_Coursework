    <worksheet name='avg total cost sea'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>Average total cost in Southeast Asia</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11' italic='true'>- Philippines has the highest cost incurred when selling their goods in Southeast Asia</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ST2187_coursework_dataset_2024-25)' name='federated.17goc4d1r1r4v21gkp8000wxland' />
          </datasources>
          <datasource-dependencies datasource='federated.17goc4d1r1r4v21gkp8000wxland'>
            <column caption='total cost ' datatype='real' name='[Calculation_1784269903451029505]' role='measure' type='quantitative'>
