            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11' italic='true'>-  Better sales tactics with discount will result in better profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ST2187_coursework_dataset_2024-25)' name='federated.17goc4d1r1r4v21gkp8000wxland' />
          </datasources>
          <datasource-dependencies datasource='federated.17goc4d1r1r4v21gkp8000wxland'>
            <column caption='adjusted profit for discount' datatype='real' name='[Calculation_2200289919516180485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Discount]&gt; 0.3 THEN [Profit]*0.8 ELSE [Profit] END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Myanmar (Burma)&quot;' value='Myanmar' />
              </aliases>
            </column>
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Sub-Category]' new-bin='true'>
                <bin default-name='true' value='&quot;Chairs &amp; Tables&quot;'>
                  <value>&quot;Chairs&quot;</value>
                  <value>&quot;Tables&quot;</value>
                </bin>
              </calculation>
