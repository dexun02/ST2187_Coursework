      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[ctd:Customer ID:qk]&quot;' value='Number of Distinct Customers' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Calculation_1784269903117389824:qk]&quot;' value='Old Shipping Delay' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Calculation_1784269903451029505:qk]&quot;' value='Old Total Cost' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Calculation_2200289919520870407:qk]&quot;' value='Improved Total Cost' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Calculation_2200289919522082824:qk]&quot;' value='Improved Shipping Delay' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Calculation_2200289919523692553:qk]&quot;' value='Forecasted Profit' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Profit:qk]&quot;' value='Profit/Loss ($)' />
          <alias key='&quot;[federated.17goc4d1r1r4v21gkp8000wxland].[sum:Sales:qk]&quot;' value='Sales ($)' />
        </aliases>
      </column>
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Quantity])) - LOOKUP(ZN(SUM([Quantity])), -1)'>
          <table-calc ordering-field='[federated.17goc4d1r1r4v21gkp8000wxland].[Region]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Shipping Days' datatype='integer' name='[Calculation_1784269903117389824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date],[Ship Date])' />
      </column>
      <column caption='total cost ' datatype='real' name='[Calculation_1784269903451029505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] - [Profit]' />
      </column>
      <column caption='Cumulative Percent' datatype='real' name='[Calculation_2200289919427043328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Profit]))/TOTAL(SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='improved profits' datatype='real' name='[Calculation_2200289919468015617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit] + ([Profit]*0.2)' />
      </column>
      <column caption='increased philipinnes profit' datatype='real' name='[Calculation_2200289919474585602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Country] = &apos;Philippines&apos; THEN 100 ELSE [Profit] END' />
      </column>
      <column caption='Reduced delay' datatype='real' name='[Calculation_2200289919479201795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1784269903117389824]*0.6' />
      </column>
      <column caption='adjusted profit for discount' datatype='real' name='[Calculation_2200289919516180485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Discount]&gt; 0.3 THEN [Profit]*0.8 ELSE [Profit] END' />
      </column>
      <column caption='loss reduction' datatype='real' name='[Calculation_2200289919517192198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Profit])-ABS([Calculation_2200289919516180485])' />
      </column>
      <column caption='20% reduction in total cost' datatype='real' name='[Calculation_2200289919520870407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1784269903451029505]*0.8' />
      </column>
      <column caption='10% lesser delivery delay' datatype='real' name='[Calculation_2200289919522082824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1784269903117389824]*0.9' />
      </column>
      <column caption='30% increase in profit' datatype='real' name='[Calculation_2200289919523692553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Profit]&lt;0 THEN [Profit]*0.7&#13;&#10;ELSEIF [Profit]&gt;0 THEN [Profit]*1.3&#13;&#10;ELSE [Profit]&#13;&#10;END' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_2370582302320267264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='profit margin' datatype='real' name='[Calculation_2376211777005363200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Profit]) / SUM([Sales])) * 100' />
      </column>
      <column caption='SALES PER ITEM' datatype='real' name='[Calculation_2524267599203889152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [Sales] ) / SUM([Quantity])' />
      </column>
      <column caption='Average Profit per Quantity' datatype='real' name='[Calculation_2524267599204569089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Profit])/([Quantity])' />
      </column>
      <column caption='AVERAGE SHIPPING COST ' datatype='real' name='[Calculation_2524267599224307714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Shipping Cost] / [Quantity]' />
      </column>
      <column caption='colour tables' datatype='string' name='[Calculation_3747276414500184064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Category] = &apos;Tables&apos; THEN &apos;Highlight&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='Delayed or not' datatype='integer' name='[Calculation_3981463594611957760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4153163330238590978] = &apos;Delayed&apos; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='percentage' datatype='real' name='[Calculation_3981463594627805185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3981463594611957760])/COUNT([Order ID]) * 100' />
      </column>
      <column caption='Shipping Delay Status' datatype='string' name='[Calculation_4153163330227814400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ship Mode] = &apos;Same Day&apos; AND [Calculation_1784269903117389824] &gt; 0 THEN &apos;Delayed - Same Day&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;First Class&apos; AND [Calculation_1784269903117389824] &gt; 2 THEN &apos;Delayed - First Class&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Second Class&apos; AND [Calculation_1784269903117389824] &gt; 3 THEN &apos;Delayed - Second Class&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Standard Class&apos; AND [Calculation_1784269903117389824] &gt; 5 THEN &apos;Delayed - Standard Class&apos;&#13;&#10;ELSE &apos;On Time&apos;&#13;&#10;END' />
      </column>
      <column caption='percentage of delayed orders' datatype='real' name='[Calculation_4153163330236829697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_4153163330238590978] = &apos;Delayed&apos; THEN 1 END) / COUNT([Calculation_1784269903117389824]) * 100' />
      </column>
      <column caption='Shipping delay status (simplified)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_4153163330238590978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ship Mode] = &apos;Same Day&apos; AND [Calculation_1784269903117389824] &gt; 0 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;First Class&apos; AND [Calculation_1784269903117389824] &gt; 2 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Second Class&apos; AND [Calculation_1784269903117389824] &gt; 3 THEN &apos;Delayed&apos;&#13;&#10;ELSEIF [Ship Mode] = &apos;Standard Class&apos; AND [Calculation_1784269903117389824] &gt; 5 THEN &apos;Delayed&apos;&#13;&#10;ELSE &apos;On Time&apos;&#13;&#10;END' />
      </column>
