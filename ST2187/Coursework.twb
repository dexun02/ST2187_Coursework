            </column>
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column caption='Original Percentage of orders delayed (copy)' datatype='real' name='[Original Percentage of orders delayed (copy)_511440083560574983]' role='measure' type='quantitative'>
