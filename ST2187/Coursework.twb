            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11' italic='true'>-  Better sales tactics with discount will result in better profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (ST2187_coursework_dataset_2024-25)' name='federated.17goc4d1r1r4v21gkp8000wxland' />
          </datasources>
          <datasource-dependencies datasource='federated.17goc4d1r1r4v21gkp8000wxland'>
            <column caption='adjusted profit for discount' datatype='real' name='[Calculation_2200289919516180485]' role='measure' type='quantitative'>
